# Tool Compass Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Core Configuration
# =============================================================================

# Project root directory (auto-detected if not set)
# TOOL_COMPASS_BASE_PATH=/path/to/mcp-tool-shop

# Python executable (auto-detected from venv if not set)
# TOOL_COMPASS_PYTHON=/path/to/python

# Configuration file path (default: ./compass_config.json)
# TOOL_COMPASS_CONFIG=/path/to/compass_config.json

# =============================================================================
# External Services
# =============================================================================

# Ollama server URL for embeddings (used when embedding_provider=ollama)
OLLAMA_URL=http://localhost:11434

# Embedding provider override (ollama | openai | openai-compatible).
# Wins over compass_config.json embedding_provider for first-run bootstrap.
# TOOL_COMPASS_EMBEDDING_PROVIDER=ollama

# API key for openai / openai-compatible embeddings. Wins over the
# embedding_api_key field in compass_config.json — keep the secret out of
# the on-disk config. Required when embedding_provider is openai or
# openai-compatible (unless the server accepts unauthenticated calls).
# TOOL_COMPASS_EMBEDDING_API_KEY=

# ComfyUI server URL (for AI image generation backend)
COMFYUI_URL=http://localhost:8188

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Gradio UI Settings
# =============================================================================

# Host / port are set on the CLI, not via env vars — `ui.py` passes them
# explicitly to Gradio's launch(), which overrides GRADIO_SERVER_NAME/PORT:
#   tool-compass ui --host 0.0.0.0 --port 7860 --auth user:pass
# (defaults: 127.0.0.1:7860; the Docker UI image binds 0.0.0.0.)

# UI login in "user:pass" format (both sides non-empty). Applied on every UI
# start when set, and REQUIRED when binding a non-loopback host (including the
# Docker UI container) or passing `--share`.
# To start the Docker UI container (or any non-loopback bind), either:
#   1. Set GRADIO_AUTH=user:pass, OR
#   2. Set TOOL_COMPASS_UI_ALLOW_NO_LOGIN=1 when running behind a proxy that
#      does its own login (prints a startup warning and hides execute controls).
# GRADIO_AUTH=user:pass
# TOOL_COMPASS_UI_ALLOW_NO_LOGIN=1

# =============================================================================
# Docker-Specific
# =============================================================================

# When running in Docker, use host.docker.internal to reach host services
# OLLAMA_URL=http://host.docker.internal:11434

# =============================================================================
# HTTP Gateway Settings (when PORT is set or `tool-compass serve --http`)
# =============================================================================

# Port for streamable-http transport (unset = stdio mode)
# PORT=8080

# Bind host for HTTP mode (default: 127.0.0.1). Non-loopback values refuse to
# start unless TOOL_COMPASS_GATEWAY_AUTH_TOKEN (or gateway_auth_token) is set,
# or TOOL_COMPASS_GATEWAY_ALLOW_NO_TOKEN=1 is set behind an authenticating proxy.
# HOST=127.0.0.1

# Bearer token for the HTTP gateway (overrides gateway_auth_token in
# compass_config.json). Required off loopback; optional on loopback.
# TOOL_COMPASS_GATEWAY_AUTH_TOKEN=

# Explicit opt-out allowing non-loopback HTTP startup without a bearer token
# when an authenticating reverse proxy sits in front (logs a startup warning).
# TOOL_COMPASS_GATEWAY_ALLOW_NO_TOKEN=1

# =============================================================================
# Analytics (optional)
# =============================================================================

# Disable analytics tracking (truthy: 1/true/yes/on). Overrides the
# analytics_enabled config-file key when set.
# TOOL_COMPASS_ANALYTICS_DISABLED=true

# Hot cache size (number of frequently used tools to pre-load). Overrides the
# hot_cache_size config-file key; clamped to a safe minimum like any config value.
# TOOL_COMPASS_HOT_CACHE_SIZE=10
